#!/usr/bin/env python3
"""agent-hub-audit: dispatcher. `agent-hub-audit run [--dry-run]` or `agent-hub-audit stats [error_stats args]`."""
import os
import runpy
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
SCRIPTS = os.path.join(os.path.dirname(HERE), "scripts")
TARGETS = {"run": "run_auditor.py", "stats": "error_stats.py"}


def main(argv):
    if not argv or argv[0] in ("-h", "--help") or argv[0] not in TARGETS:
        out = sys.stdout if not argv or argv[0] in ("-h", "--help") else sys.stderr
        out.write("Usage: agent-hub-audit run [--dry-run] | stats [CODE_ROOT] [--json] [--top N] "
                  "[--recurring-threshold N] [--strict]\n")
        return 0 if out is sys.stdout else 3
    sys.argv = [TARGETS[argv[0]]] + argv[1:]
    sys.path.insert(0, SCRIPTS)
    mod = runpy.run_path(os.path.join(SCRIPTS, TARGETS[argv[0]]), run_name="agent_hub_audit_target")
    return mod["main"](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
