#!/usr/bin/env python3
"""agent-hub: one entry point for the plugin's scripts.

usage: agent-hub <subcommand> [args]
Runs the script behind the subcommand with the remaining arguments; each script keeps its own CLI."""
import os
import sys

MIN_PYTHON = (3, 11)

SUBCOMMANDS = {  # subcommand -> script file in scripts/
    "check": None,  # check <plan|ruleset>
    "stamp": None,  # stamp plan <change-dir> --words <file>
    "store": None,  # store <match|list|verify>
    "locate": "plan-locate.py",
    "review-packet": "review-packet.py",
    "secret-scan": "secret-scan.py",
    "worktree-sweep": "worktree-sweep.py",
    "lesson": "lesson-ledger.py",
    "return-check": "return-check.py",  # return-check <file> [--agent <role>] [--cwd <dir>]
    "ledger": "ledger-record.py",
    "rule": "rule-slice.py",  # rule <file>[#<heading>]: print one section of a rule file
    "idle": "idle-report.py",  # idle <session.jsonl | session dir> [--json]
    "cache": "research-cache.py",  # cache <find <words...> | promote [--archive] <slug> | lint> [--dir <cache dir>]
}
RULESET_MESSAGE = "ruleset mode runs only in the agent-hub package repo: python3 tools/check.py ruleset"
OPENSPEC_ABSENT = "openspec: not installed, validate skipped (owed)"


def python_floor_error(version_info):
    """The message to print when this interpreter is older than the floor, else None."""
    if tuple(version_info[:2]) < MIN_PYTHON:
        return "agent-hub needs Python %d.%d or newer (found %d.%d)" % (MIN_PYTHON + tuple(version_info[:2]))
    return None


def usage():
    names = " | ".join(SUBCOMMANDS)
    return "usage: agent-hub <subcommand> [args]\nsubcommands: " + names + "\nagent-hub <subcommand> --help shows that script's options"


def run_script(root, script, argv, prog):
    import runpy
    sys.argv = [prog] + argv
    try:
        runpy.run_path(str(root / "scripts" / script), run_name="__main__")
    except SystemExit as e:
        return e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
    return 0


def check_plan(root, argv):
    """openspec validate --strict when the binary is on PATH, then always the five checks; exit 0 only when both pass.
    The folder is the first argument that is not a flag (`check plan --stamped <dir>` is valid)."""
    import shutil
    import subprocess
    names = [a for a in argv if not a.startswith("--")]
    if not names:
        print("usage: agent-hub check plan [--stamped] <change-dir>", file=sys.stderr)
        return 2
    from pathlib import Path
    folder = Path(names[0])
    code = 0
    if shutil.which("openspec"):
        code = subprocess.run(["openspec", "validate", folder.name, "--strict"], cwd=str(folder.parent.parent.parent), env={**os.environ, "OPENSPEC_TELEMETRY": "0"}).returncode
    else:
        print(OPENSPEC_ABSENT)
    checks = run_script(root, "plan-check.py", argv, "agent-hub check plan")
    return code or checks


def run_store(root, argv):
    import importlib.util
    if not argv or argv[0] not in ("match", "list", "verify"):
        print("usage: agent-hub store <match | list | verify> [args]", file=sys.stderr)
        return 2
    spec = importlib.util.spec_from_file_location("store_match", root / "scripts" / "store-match.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.main(argv)


def main(argv):
    from pathlib import Path
    root = Path(__file__).resolve().parents[1]
    sys.path.insert(0, str(root / "scripts"))
    import _paths
    lib = _paths.lib_path()
    if lib.is_dir():
        sys.path.insert(0, str(lib))
    if not argv:
        print(usage(), file=sys.stderr)
        return 2
    sub, rest = argv[0], argv[1:]
    if sub in ("-h", "--help"):
        print(usage())
        return 0
    if sub not in SUBCOMMANDS:
        print("agent-hub: unknown subcommand '%s'\n%s" % (sub, usage()), file=sys.stderr)
        return 2
    if sub == "check":
        if not rest or rest[0] in ("-h", "--help"):
            stream = sys.stdout if rest else sys.stderr
            print("usage: agent-hub check <plan | ruleset> [args]", file=stream)
            return 0 if rest else 2
        if rest[0] == "ruleset":
            print(RULESET_MESSAGE, file=sys.stderr)
            return 2
        if rest[0] != "plan":
            print("agent-hub check: unknown target '%s' (plan | ruleset)" % rest[0], file=sys.stderr)
            return 2
        return check_plan(root, rest[1:])
    if sub == "stamp":
        if not rest or rest[0] != "plan":
            print("usage: agent-hub stamp plan <change-dir> --words <file>", file=sys.stderr)
            return 2
        return run_script(root, "plan-check.py", ["stamp"] + rest[1:], "agent-hub stamp plan")
    if sub == "store":
        return run_store(root, rest)
    return run_script(root, SUBCOMMANDS[sub], rest, "agent-hub " + sub)


if __name__ == "__main__":
    error = python_floor_error(sys.version_info)
    if error:
        print(error, file=sys.stderr)
        sys.exit(2)
    sys.exit(main(sys.argv[1:]))
