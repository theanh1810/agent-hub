{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1 || echo '{\"systemMessage\":\"agent-hub: Python 3.11+ not found as python3; hooks and scripts are off. Install Python 3.11+ and restart.\"}'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_inject.py\" SessionStart 1",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_inject.py\" SessionStart 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_inject.py\" SessionStart 3",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/clear_handoff.py\" start",
            "timeout": 10,
            "statusMessage": "Loading last task summary..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/post_compact_pointer.py\"",
            "timeout": 10,
            "statusMessage": "Re-pointing to session files..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^agent-hub:",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_inject.py\" SubagentStart 1",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^agent-hub:",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_inject.py\" SubagentStart 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^agent-hub:",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_inject.py\" SubagentStart 3",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/git_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking git safety..."
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/read_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/clear_handoff.py\" end",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree_create.py\"",
            "timeout": 120,
            "statusMessage": "Creating agent worktree..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree_remove.py\"",
            "timeout": 30,
            "statusMessage": "Removing agent worktree..."
          }
        ]
      }
    ]
  }
}
