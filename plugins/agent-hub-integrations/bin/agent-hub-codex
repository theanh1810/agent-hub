#!/usr/bin/env bash
# agent-hub-codex <convert|install> [args...]: dispatch to the Codex conversion scripts of this plugin.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cmd="${1:-}"
case "$cmd" in
  convert) shift; exec python3 "$root/scripts/codex-convert.py" "$@" ;;
  install) shift; exec python3 "$root/scripts/codex-install.py" "$@" ;;
  *) echo "usage: agent-hub-codex <convert|install> [args...]" >&2; exit 2 ;;
esac
